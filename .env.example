# ===== 必填：QQ 开放平台机器人凭据 =====
# 获取位置：https://q.qq.com  -> 机器人 -> 开发 -> 开发设置
# 注意：这个文件是模板，不要在这里填真实值。真实值写进 .env
QQ_APP_ID=
QQ_APP_SECRET=

# ===== 群配置 =====
# 需要服务的群 OpenID，逗号分隔。留空 = 自动服务机器人所在的所有群
# 不知道 OpenID 时：把机器人拉进群，@它 发送「群ID」
QQ_GROUP_OPENIDS=

# 是否订阅群内全部消息（用于自动抽取待办）。
# true 需要机器人后台开启「接收所有消息」；false 则只处理 @ 机器人的消息
FULL_MESSAGE_MODE=true

# ===== 定时任务（cron 表达式，服务器本地时区见 TZ）=====
# 周报：每周六 08:00 推送本周待办。
# QQ 主动消息每群每月只有 4 条左右，所以只保留这一个定时推送，且强制单条发送。
DIGEST_CRON=0 8 * * 6
# 每月只有 4 条主动消息配额，而有的月份有 5 个周六。
# true = 只放行每月 1-28 号（任何星期几都恰好 4 次），29 号之后的第 5 周自动跳过。
WEEKLY_ONLY=true
# 到期提醒：留空 = 关闭。开启会和周报抢每月那几条主动消息配额。
REMIND_CRON=
# 课程主动提醒：同样吃配额，默认关闭；设 true 会把周报的额度吃掉。
COURSE_PUSH=false

# 推送范围：all=全部待办（默认）；urgent=只推逾期/今天/明天到期的
DIGEST_MODE=all

# ===== 待办抽取 =====
# 没配 LLM_API_KEY 时，用规则从群消息里抽待办（只认结构明确的句子）。
# 规则版宁可漏，不肯错——把闲聊塞进待办库比漏掉更烦人。
RULE_EXTRACT=true

# 每收到一条群消息就在日志里留一行（截断 40 字）。
# 用来确认「群主开了全量消息权限之后，消息到底有没有进来」。
# 介意服务器日志里留聊天内容就改成 false。
LOG_GROUP_MESSAGES=true

# 群消息原文存档：写到 data/messages/<日期>.jsonl，只留最近 7 天，
# 供 `npm run cli -- replay` 拿真实语料重放抽取规则。
#
# 这一行**故意注释掉**，不是漏写：
# 不设时它自动跟随上面的 LOG_GROUP_MESSAGES——日志关了就不存档。
# 只有这样，从旧版升上来的人行为才和以前完全一致（以前两者是绑在一起的）。
# 如果这里直接写 true，反而会让「关掉日志」的人升级后突然开始把完整聊天存到磁盘，
# 那正是他们当初关掉的东西。
#
# 想让两者分开（比如日志留痕但不想存原文），才取消注释并明确写值：
# ARCHIVE_GROUP_MESSAGES=false

# 没有截止日的待办在推送里出现几次后自动退场（库里仍保留，@我 还能查到）。
# 日期待定（等通知的事）：默认 3 次；无期限（长期有效的事）：默认 2 次。
# 不设上限的话，一条「看 CAD 回放」会跟着周报推一整个学期，人就再也不看周报了。
PENDING_SHOW_LIMIT=3
ONGOING_SHOW_LIMIT=2

# ===== 自动销项 =====
# 过了截止日还没人销的，自动归档（不再出现在任何推送里）。
# 想找回来：群里发「#恢复 关键词」
AUTO_CLOSE_OVERDUE=true
# 每天什么时候扫一次（默认凌晨 0:10，服务启动时也会先跑一次）
AUTO_CLOSE_CRON=10 0 * * *

# ===== 数据快照（同机备份） =====
# 每天把 data/ 下的 JSON 打成一个快照文件放在 backups/ 里。
# 防的是机器人自己把数据写坏，防不了机器整台丢失——异地备份定期 scp 拉一份。
BACKUP_ENABLED=true
BACKUP_CRON=20 3 * * *
# 保留最近多少份
BACKUP_KEEP=14

# ===== 课程提醒 =====
# 静默时段（24 小时制）。这段时间内不发课程提醒，避免半夜刷群。
# 只对课程提醒生效，待办日报和到期提醒按 cron 走，不受影响。
QUIET_START_HOUR=0
QUIET_END_HOUR=7

# ===== 可选：用大模型从群聊里抽取待办 =====
# 不填也能用：会走 RULE_EXTRACT 的规则抽取。
# 想提高准确率再配，任何 OpenAI 兼容接口都行。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== 可选：机器人自己的 openid =====
# 开启「接收所有消息」后，部分账号只会收到普通群消息事件，不再单推 @ 事件。
# 填了它就能从消息正文的 <@!id> 里精确判断「这是在 @ 我」；
# 留空会自动调 /users/@me 取一次，取不到则退回「@ 标记 + 指令词」的启发式判断。
BOT_OPENID=

# ===== 其他 =====
TZ=Asia/Shanghai
DATA_DIR=./data
LOG_LEVEL=info
